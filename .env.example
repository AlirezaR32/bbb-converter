# ==============================================================================
# BigBlueButton Recording Converter — backend environment
# Copy to backend/.env (or set in docker-compose) and adjust.
# Every value below is a safe placeholder; change SECRET_KEY in production!
# ==============================================================================

# --- application ---
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Public URL of THIS backend (used to build/allow the bundled demo recording URL)
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
# Absolute base URL placed into download links. Leave empty for same-origin
# deployments (Docker on one host). Set it when the API lives on a different domain
# than the UI, e.g. Render + Vercel: PUBLIC_DOWNLOAD_BASE_URL=https://bbb-api.onrender.com
PUBLIC_DOWNLOAD_BASE_URL=

# --- database (SQLite for dev; PostgreSQL in the Docker deployment) ---
DATABASE_URL=sqlite:///./data/bbb_converter.db
# DATABASE_URL=postgresql+psycopg2://bbb:bbb_password@postgres:5432/bbb_converter

# --- job queue: inline (single node, zero infra) or celery (Redis-backed) ---
JOB_QUEUE=inline
REDIS_URL=redis://redis:6379/0

# --- storage ---
DATA_DIR=./data
OUTPUT_TTL_HOURS=24
CLEANUP_INTERVAL_MINUTES=10
STORAGE_QUOTA_GB=25
MIN_FREE_DISK_GB=2

# --- limits ---
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_IP=4
MAX_RECORDING_HOURS=8
MAX_ASSET_MB=2048
MAX_TOTAL_ASSETS_MB=4096
FFMPEG_TIMEOUT_S=10800
DOWNLOAD_TIMEOUT_S=1800
REQUEST_TIMEOUT_S=30
RATE_LIMIT_PER_MINUTE=20

# --- network / SSRF ---
ALLOW_INSECURE_HTTP=false
VERIFY_TLS=true
MAX_REDIRECTS=5
ALLOWED_PORTS=80,443
# Extra comma-separated URL prefixes that bypass private-network checks.
# Keep empty in production unless you must whitelist a specific BBB host.
EXTRA_ALLOWED_URL_PREFIXES=

# --- demo mode (bundled synthetic recording, clearly separated) ---
DEMO_MODE=true

# --- CORS (comma-separated origins, * for any; the UI is same-origin) ---
CORS_ORIGINS=*
